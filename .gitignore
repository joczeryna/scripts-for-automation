Set-Content -Path "C:\Users\jd0855\Desktop\VCI_Automation\.gitignore" -Value @'
# ==========================================
# Environment and Authentication
# ==========================================
**/.env
**/.env.*
!**/.env.example
**/*credentials*.json
**/token*.json
**/*secret*.json
**/*.pem
**/*.key
SecurityBindings

# ==========================================
# Python & Virtual Environments
# ==========================================
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc
**/*.pyo

# ==========================================
# Automation Runtime, Logs, and Temp Files
# ==========================================
**/*.log
**/logs/
**/temp/
**/downloads/
**/browser-profile/
**/browser_profiles/
**/*.crdownload
**/*.tmp
**/*.flag
**/data.json

# ==========================================
# Power BI Project (.pbip) Artifacts
# ==========================================
**/localSettings.json
**/.pbi/localSettings.json
**/.pbi/editorSettings.json
**/cache.abf
*.lock

# ==========================================
# OS Metadata & Backups
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
~$*
* - Copy.py
'@
**/debug_save_as_*
